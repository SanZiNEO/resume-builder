{
  "name": "dsh-resume-cv",
  "version": "0.1.0",
  "description": "简历模式：把 dsh 变成简历顾问（人设 + 写边界 + 导出 + 右栏实时预览）",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "resume",
    "resume-builder"
  ],
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./policy": "./lib/policy.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "knowledge",
    "icon.svg",
    "workspace-template.tgz"
  ],
  "meta": {
    "title": "简历模式",
    "description": "把当前会话变成简历顾问：只改简历项目里的 YAML / CSS，随时导出，右栏实时预览。"
  },
  "icon": "./icon.svg",
  "peerDependencies": {
    "@deepseek-ai/dsh-agent-instructions": "*",
    "@deepseek-ai/dsh-agent-preset": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-persona": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "template:pack": "node scripts/pack-template.mjs",
    "prepack": "npm run build && npm run check:bundle && npm run template:pack"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-sidebar-browser",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-api-settings-controller"
      ]
    }
  },
  "dependencies": {
    "puppeteer-core": "^25.16.0",
    "yaml": "2.9.1"
  }
}
